# Base URL of the backend, WITHOUT the /api suffix (the app adds that itself).
#
# - Android emulator: defaults to http://10.0.2.2:8081, no need to set this.
# - iOS simulator / web: defaults to http://localhost:8081, no need to set this.
# - Physical device or EAS build: set this to your machine's LAN IP or the
#   deployed backend's URL, e.g. http://192.168.1.42:8081
#
# Copy this file to .env and adjust as needed. Expo inlines EXPO_PUBLIC_*
# variables at build time — no extra tooling required.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
