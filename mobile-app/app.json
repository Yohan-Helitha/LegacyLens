{
  "expo": {
    "name": "Legacy Lens",
    "slug": "legacy-lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDEFEE",
    "splash": {
      "backgroundColor": "#EDEFEE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legacylens.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDEFEE"
      },
      "package": "com.legacylens.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Legacy Lens needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Legacy Lens needs camera access so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Legacy Lens uses Face ID so you can log in quickly and securely."
        }
      ]
    ]
  }
}
