{
  "expo": {
    "name": "Legacy Lens",
    "slug": "legacy-lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDEFEE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legacylens.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDEFEE"
      },
      "package": "com.legacylens.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Legacy Lens needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Legacy Lens needs camera access so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Legacy Lens needs camera access so you can record a video story.",
          "microphonePermission": "Legacy Lens needs microphone access to record sound with your video story.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Legacy Lens uses Face ID so you can log in quickly and securely."
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition",
      "@rnmapbox/maps",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDEFEE"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8c6e928a-5b8e-4f5b-a1b3-7b37a37e3cf6"
      }
    }
  }
}
