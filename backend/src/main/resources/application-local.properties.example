# ─────────────────────────────────────────────────────────────────────────────
# LOCAL SECRETS TEMPLATE — Safe to commit
# Copy this file to application-local.properties and fill in real values.
# NEVER put real credentials in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase DB password (get from Supabase → Settings → Database)
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JWT secret — generate a strong random string (min 32 chars)
JWT_SECRET=YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG

# Google Gemini API key for AI Study Builder
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash

# Groq API Configuration (for app.ai.provider=groq)
app.ai.provider=groq
learning.ai.groq.api-key=YOUR_GROQ_API_KEY
learning.ai.groq.model=llama-3.3-70b-versatile
